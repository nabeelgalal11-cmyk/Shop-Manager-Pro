modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[[artifacts]]
id = "artifacts/api-server"

[[artifacts]]
id = "artifacts/mockup-sandbox"

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

[nix]
channel = "stable-25_05"
packages = ["ghost-cli", "glib", "nss", "nspr", "atk", "at-spi2-atk", "cups", "dbus", "expat", "libdrm", "gtk3", "pango", "cairo", "alsa-lib", "xorg.libX11", "xorg.libxcb", "xorg.libXcomposite", "xorg.libXdamage", "xorg.libXext", "xorg.libXfixes", "xorg.libXrandr", "xorg.libXScrnSaver", "xorg.libxshmfence", "mesa", "libgbm", "libxkbcommon"]

[userenv]

[userenv.shared]
HOSTGATOR_PUBLIC_BASE_URL = "https://Znmotors.com"
PUBLIC_BASE_URL = "https://shop-manager-pro.replit.app"
SQUARE_APPLICATION_ID = "sq0idp-ZBXRyzxhOfjb-s7CD-PxWg"
SQUARE_ENVIRONMENT = "production"

[userenv.development]
DEVELOPMENT_RESTORE_TARGET = "ep-cold-sun-b4krbjne-pooler.c-6.us-east-2.aws.neon.tech/neondb"

[[ports]]
localPort = 5173
externalPort = 5173

[[ports]]
localPort = 8080
externalPort = 80

[[ports]]
localPort = 8081
externalPort = 8081
