{
  "expo": {
    "name": "915motors Mobile",
    "slug": "915motors-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "motors915",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.motors915.mobile"
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "splash": {
      "backgroundColor": "#f8fafc"
    },
    "extra": {
      "apiBaseUrl": "https://app.915motorsusa.com"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
